{
  "name": "ethiofoodcast-web",
  "version": "0.1.0",
  "private": true,
  "description": "EthioFoodCast decision-support workspace (Next.js). See ../docs/FRONTEND_DESIGN.md.",
  "scripts": {
    "predev": "node scripts/copy-data.mjs",
    "dev": "next dev --port 3001",
    "build": "node scripts/copy-data.mjs && next build",
    "start": "next start --port 3001",
    "check": "tsc --noEmit",
    "lint": "eslint .",
    "data": "node scripts/copy-data.mjs",
    "openapi:dump": "python ../scripts/dump_openapi.py"
  },
  "dependencies": {
    "next": "^15.3.3",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.27",
    "marked": "^15.0.12",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20.11"
  }
}
